# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# VAPI (Dashboard > API Keys)
VAPI_API_KEY=
# Secreto compartido: se envía como header x-webhook-secret en cada request al webhook (ver lib/vapi/sync.ts).
VAPI_WEBHOOK_SECRET=

# Google Cloud (OAuth 2.0 Client ID de tipo "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# URL pública de esta app (sin slash final). En local: http://localhost:3000
APP_URL=http://localhost:3000

# Clave para cifrar tokens de Google en BD (AES-256-GCM).
# Genera 32 bytes aleatorios, por ejemplo: openssl rand -hex 32
ENCRYPTION_KEY=

# Valores por defecto del agente VAPI (personalizables por clínica en el panel de Personalización)
VAPI_DEFAULT_MODEL_PROVIDER=openai
VAPI_DEFAULT_MODEL=gpt-4.1
VAPI_DEFAULT_VOICE_PROVIDER=azure
VAPI_DEFAULT_VOICE_ID=es-MX-DaliaNeural
VAPI_DEFAULT_TRANSCRIBER=deepgram
VAPI_DEFAULT_TRANSCRIBER_MODEL=nova-3
VAPI_DEFAULT_TRANSCRIBER_LANGUAGE=es
