# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secreto compartido para los cron que disparan las respuestas demoradas y
# los seguimientos automáticos de WhatsApp (header x-cron-secret, ver
# api/whatsapp/process-pending, api/whatsapp/send-followups y las migraciones
# 0032/0036 para el pg_cron + pg_net que los llaman).
WHATSAPP_CRON_SECRET=

# Claude (Anthropic) — una sola clave de la plataforma (no por negocio),
# usada para responder automáticamente los mensajes de WhatsApp de todos
# los negocios con el mismo prompt/herramientas.
ANTHROPIC_API_KEY=

# Google Cloud (OAuth 2.0 Client ID de tipo "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Meta — "Conectar con Facebook" (WhatsApp Embedded Signup), alternativa al
# formulario manual de WhatsApp. Se crean en developers.facebook.com: una App
# tipo "Business" con los productos WhatsApp + Facebook Login for Business,
# y dentro de este último una Configuración de tipo "Embedded Signup" con
# token "Never expires" (ahí se obtiene el Configuration ID).
META_APP_ID=
NEXT_PUBLIC_META_APP_ID=
META_APP_SECRET=
NEXT_PUBLIC_META_CONFIG_ID=
# Verify token único de la app, configurado una sola vez en Meta > WhatsApp >
# Configuración > Webhooks — lo usan todas las clínicas conectadas por este
# método (las conectadas a mano siguen usando su propio token, por clínica).
META_WEBHOOK_VERIFY_TOKEN=

# URL pública de esta app (sin slash final). En local: http://localhost:3000
APP_URL=http://localhost:3000

# Clave para cifrar tokens de Google y WhatsApp en BD (AES-256-GCM).
# Genera 32 bytes aleatorios, por ejemplo: openssl rand -hex 32
ENCRYPTION_KEY=

# Notificaciones push del navegador (panel de CRM) — un solo par de claves de
# la plataforma, no por negocio. Generalas con:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
