# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Retell AI: cada negocio conecta su propia API key desde el panel
# (Integraciones), se guarda cifrada en la tabla retell_credentials — no hay
# clave global. La firma de los webhooks (X-Retell-Signature) se verifica con
# esa misma clave por-tenant, no con un secreto compartido.

# Claude (Anthropic) — una sola clave de la plataforma (no por negocio),
# usada para responder automáticamente los mensajes de WhatsApp de todos
# los negocios con el mismo prompt/herramientas que usan sus llamadas.
ANTHROPIC_API_KEY=

# Google Cloud (OAuth 2.0 Client ID de tipo "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# URL pública de esta app (sin slash final). En local: http://localhost:3000
APP_URL=http://localhost:3000

# Clave para cifrar tokens de Google en BD (AES-256-GCM).
# Genera 32 bytes aleatorios, por ejemplo: openssl rand -hex 32
ENCRYPTION_KEY=
